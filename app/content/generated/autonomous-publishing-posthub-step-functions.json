4E8\">  }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre>\n</div><hr /><h2 id=\"high-performance-security-dynamic-x509-jwt-authorizer-caching\" class=\"group flex items-center gap-2 text-balance scroll-mt-24\"><span>High-Performance Security: Dynamic x509 JWT Authorizer Caching</span><a href=\"#high-performance-security-dynamic-x509-jwt-authorizer-caching\" class=\"heading-anchor text-gray-400 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity text-sm no-underline\" data-i18n-aria=\"linkToSection\" aria-label=\"Link to section\">#</a></h2><p class=\"text-pretty\">PostHub's management dashboard is secured via Google OAuth2 OpenID Connect (OIDC). However, verifying RS256 JWT tokens naively requires fetching Google's public x509 certificates (<code>https://www.googleapis.com/oauth2/v3/certs</code>) on every single API invocation—introducing 100ms+ of cold-path network latency.</p><p class=\"text-pretty\">To achieve sub-10ms authorizer execution, PostHub caches public keys in the Lambda container's memory across warm invocations with automatic TTL-based rotation:</p><div class=\"code-block relative my-5 rounded-xl overflow-hidden border border-slate-200 dark:border-gray-800 shadow-sm group\">\n<div class=\"code-block-header flex items-center justify-between px-4 py-1.5 text-xs font-mono\">\n<span class=\"font-medium\">typescript</span>\n<button type=\"button\" class=\"copy-code-btn inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded transition-colors\" data-code=\"%2F%2F%20lambdas%2Fauthorizer%2FjwtVerifier.ts%0Aimport%20%7B%20createRemoteJWKSet%2C%20jwtVerify%20%7D%20from%20%22jose%22%3B%0A%0A%2F%2F%20The%20remote%20JWKS%20set%20is%20initialized%20outside%20the%20handler%2C%0A%2F%2F%20automatically%20caching%20keys%20in%20memory%20and%20refreshing%20them%20on%20expiration.%0Aconst%20GOOGLE_JWKS%20%3D%20createRemoteJWKSet(%0A%20%20new%20URL(%22https%3A%2F%2Fwww.googleapis.com%2Foauth2%2Fv3%2Fcerts%22)%2C%0A%20%20%7B%0A%20%20%20%20cooldownDuration%3A%2030000%2C%20%20%20%20%2F%2F%2030%20seconds%20cooldown%20between%20refreshes%0A%20%20%20%20cacheMaxAge%3A%2021600000%2C%20%20%20%20%20%2F%2F%206%20hours%20cache%20TTL%0A%20%20%7D%0A)%3B%0A%0Aexport%20async%20function%20verifyUserToken(token%3A%20string)%20%7B%0A%20%20const%20%7B%20payload%20%7D%20%3D%20await%20jwtVerify(token%2C%20GOOGLE_JWKS%2C%20%7B%0A%20%20%20%20issuer%3A%20%5B%22https%3A%2F%2Faccounts.google.com%22%2C%20%22accounts.google.com%22%5D%2C%0A%20%20%20%20audience%3A%20process.env.GOOGLE_CLIENT_ID%2C%0A%20%20%7D)%3B%0A%0A%20%20return%20%7B%0A%20%20%20%20sub%3A%20payload.sub%2C%0A%20%20%20%20email%3A%20payload.email%20as%20string%2C%0A%20%20%20%20authorized%3A%20payload.email%20%3D%3D%3D%20process.env.ADMIN_EMAIL%2C%0A%20%20%7D%3B%0A%7D\" data-i18n-aria=\"copyCode\" aria-label=\"Copy code\"><svg width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg><span data-copy-label>Copy</span></button>\n</div>\n<pre class=\"shiki shiki-themes github-light github-dark shiki-pre\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\"><code><span class=\"line\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// lambdas/authorizer/jwtVerifier.ts</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> { createRemoteJWKSet, jwtVerify } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> \"jose\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// The remote JWKS set is initialized outside the handler,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// automatically caching keys in memory and refreshing them on expiration.</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> GOOGLE_JWKS</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> createRemoteJWKSet</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  new</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> URL</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"https://www.googleapis.com/oauth2/v3/certs\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">),</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    cooldownDuration: </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">30000</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,    </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// 30 seconds cooldown between refreshes</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    cacheMaxAge: </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">21600000</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,     </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// 6 hours cache TTL</span></span>\n<span class=\"line\"><