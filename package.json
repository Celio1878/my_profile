{
  "name": "my_profile",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build-blog.ts && react-router build",
    "dev": "bun run scripts/build-blog.ts && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "find-deadcode": "ts-prune",
    "lint": "eslint . --max-warnings=0",
    "content:build": "bun run scripts/build-blog.ts",
    "audit:content": "bun run scripts/audit-content.ts",
    "smoke": "bun run scripts/smoke-ssr.ts",
    "sync-substack": "bun run scripts/sync-substack.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^11.0.1",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1"
  }
}
